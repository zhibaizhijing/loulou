.ll-sc-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  border: 1px solid var(--ll-border);
  background: var(--ll-surface);
  color: var(--ll-text);
  display: flex; align-items: center; justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.ll-sc-btn.is-primary {
  border: 0;
  background: var(--ll-ink);
  color: var(--ll-text-on-ink);
}
.ll-sc-btn-label { line-height: 1; }
