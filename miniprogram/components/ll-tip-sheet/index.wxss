.ll-ts-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.42); z-index: 90;
}
.ll-ts-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 91;
  background: var(--ll-surface);
  border-top-left-radius: 40rpx; border-top-right-radius: 40rpx;
  padding: 28rpx 36rpx 64rpx;
}
.ll-ts-grab {
  width: 76rpx; height: 8rpx; border-radius: 4rpx;
  background: var(--ll-border); margin: 0 auto 32rpx;
}
.ll-ts-title {
  text-align: center;
  font-size: 32rpx; font-weight: 700;
  color: var(--ll-text); margin-bottom: 8rpx;
}
.ll-ts-sub {
  text-align: center;
  font-size: 25rpx; color: var(--ll-text-3);
  margin-bottom: 36rpx;
}
.ll-ts-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx;
}
.ll-ts-amt {
  height: 108rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--ll-border);
  background: var(--ll-surface);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 800; color: var(--ll-text);
  font-variant-numeric: tabular-nums;
}
