/* v3 primitive — Button. Contract: components/Button/Button.jsx.
   Sizing per spec 2026-07-05 §2.1:
     sm — 72rpx height, 32rpx h-pad, 26rpx font
     md — 88rpx        , 48rpx     , 30rpx
     lg — 104rpx       , 56rpx     , 32rpx
*/
.ll-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: var(--ll-radius-pill);
  border: 0;
  box-sizing: border-box;
  font-weight: 600;
  letter-spacing: 0.01em;
  transition: background var(--ll-dur-fast) var(--ll-ease),
              transform  var(--ll-dur-fast) var(--ll-ease);
}
.ll-cta.is-block { display: flex; width: 100%; padding-left: 0; padding-right: 0; }

/* Sizes */
.ll-cta--sm { height: 72rpx;  padding: 0 32rpx; font-size: 26rpx; }
.ll-cta--md { height: 88rpx;  padding: 0 48rpx; font-size: 30rpx; }
.ll-cta--lg { height: 104rpx; padding: 0 56rpx; font-size: 32rpx; }

/* Variants */
.ll-cta--primary {
  background: var(--ll-ink);
  color: var(--ll-text-on-ink);
}
.ll-cta--primary.is-pressed  { background: var(--ll-ink-press); transform: scale(0.985); }
.ll-cta--primary.is-disabled { background: var(--ll-ink-disabled); }

.ll-cta--secondary {
  background: transparent;
  color: var(--ll-text);
  box-shadow: inset 0 0 0 3rpx var(--ll-border);
}
.ll-cta--secondary.is-pressed  { background: var(--ll-surface-2); }
.ll-cta--secondary.is-disabled { color: var(--ll-text-3); }

.ll-cta--ghost {
  background: transparent;
  color: var(--ll-text-2);
}
.ll-cta--ghost.is-pressed  { background: var(--ll-surface-2); }
.ll-cta--ghost.is-disabled { color: var(--ll-text-3); }

.ll-cta--danger {
  background: transparent;
  color: var(--ll-danger);
  box-shadow: inset 0 0 0 3rpx var(--ll-border);
}
.ll-cta--danger.is-pressed  { background: var(--ll-surface-2); }
.ll-cta--danger.is-disabled { color: var(--ll-text-3); }

.ll-cta-text { font-family: inherit; }

/* Loading spinner (14×14 in design; 28rpx here to match the base sizing). */
.ll-cta-spinner {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.35);
  border-top-color: #fff;
  animation: ll-cta-spin 0.8s linear infinite;
}
.ll-cta--secondary .ll-cta-spinner,
.ll-cta--ghost     .ll-cta-spinner,
.ll-cta--danger    .ll-cta-spinner {
  border-color: rgba(30,30,36,0.15);
  border-top-color: var(--ll-text);
}
@keyframes ll-cta-spin { to { transform: rotate(360deg); } }
