<view
  class="ll-cta {{full ? 'is-full' : ''}} {{secondary ? 'is-secondary' : ''}} {{danger ? 'is-danger' : ''}} {{disabled ? 'is-disabled' : ''}} {{loading ? 'is-loading' : ''}} {{pressed ? 'is-pressed' : ''}}"
  bindtap="onTap"
  bindtouchstart="onPressIn"
  bindtouchend="onPressOut"
  bindtouchcancel="onPressOut"
>
  <view wx:if="{{loading}}" class="ll-spinner"></view>
  <text class="ll-cta-text">{{text}}</text>
  <slot/>
</view>
