<view
  class="ll-cta ll-cta--{{resolvedVariant}} ll-cta--{{size}} {{resolvedBlock ? 'is-block' : ''}} {{disabled ? 'is-disabled' : ''}} {{loading ? 'is-loading' : ''}} {{pressed ? 'is-pressed' : ''}}"
  bindtap="onTap"
  bindtouchstart="onPressIn"
  bindtouchend="onPressOut"
  bindtouchcancel="onPressOut"
>
  <view wx:if="{{loading}}" class="ll-cta-spinner"></view>
  <text wx:if="{{text}}" class="ll-cta-text">{{text}}</text>
  <slot/>
</view>
