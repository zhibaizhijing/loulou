.ll-chips-scroll { width: 100%; white-space: nowrap; }
.ll-chips-row    { display: inline-flex; gap: 16rpx; padding: 0 var(--ll-safe-x); }
.ll-chip {
  flex: 0 0 auto;
  height: 68rpx;
  padding: 0 36rpx;
  border-radius: var(--ll-radius-pill);
  background: var(--ll-surface);
  color: var(--ll-text);
  font-size: 26rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  box-shadow: inset 0 0 0 2rpx var(--ll-border);
  white-space: nowrap;
}
.ll-chip.is-on {
  background: var(--ll-ink);
  color: var(--ll-text-on-ink);
  font-weight: 600;
  box-shadow: none;
}
