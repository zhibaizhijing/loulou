.ll-cpm-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 90;
}
.ll-cpm-card {
  position: fixed; left: 32rpx; right: 32rpx; top: 50%; z-index: 91;
  background: var(--ll-surface);
  border-radius: 32rpx;
  transform: translateY(-50%);
  padding: 28rpx 32rpx 32rpx;
}
.ll-cpm-head { display: flex; align-items: center; margin-bottom: 24rpx; }
.ll-cpm-title { flex: 1; font-size: 32rpx; font-weight: 700; color: var(--ll-text); }
.ll-cpm-close {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: #F0F0F5;
  display: flex; align-items: center; justify-content: center;
}
.ll-cpm-tier {
  padding: 20rpx 0;
  border-bottom: 1px solid var(--ll-border);
}
.ll-cpm-tier:last-child { border-bottom: 0; }
.ll-cpm-tier-label {
  display: block;
  font-size: 28rpx; font-weight: 700; color: var(--ll-text);
  margin-bottom: 8rpx;
}
.ll-cpm-tier-detail {
  font-size: 25rpx; color: var(--ll-text-2); line-height: 1.5;
}
