/* v3 — cancel-order modal. Bottom-anchored card per design BsCancelOrderModal. */
.ll-cpm-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 95;
}
.ll-cpm-card {
  position: fixed; left: 32rpx; right: 32rpx; bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 96;
  background: var(--ll-surface);
  border-radius: 40rpx;
  box-shadow: 0 32rpx 96rpx rgba(0,0,0,0.18);
  overflow: hidden;
}

.ll-cpm-head {
  padding: 40rpx 40rpx 28rpx;
  border-bottom: 1px solid var(--ll-border);
  display: flex; align-items: center;
}
.ll-cpm-head-text { display: flex; flex-direction: column; }
.ll-cpm-title { font-size: 32rpx; font-weight: 700; color: var(--ll-text); }
.ll-cpm-sub {
  font-size: 24rpx; color: var(--ll-text-3);
  margin-top: 4rpx;
}
.ll-cpm-close {
  margin-left: auto;
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: #F0F0F5;
  display: flex; align-items: center; justify-content: center;
}

.ll-cpm-body {
  padding: 28rpx 40rpx 8rpx;
  display: flex; flex-direction: column; gap: 28rpx;
}
.ll-cpm-tier {
  display: flex; gap: 24rpx; align-items: flex-start;
}
.ll-cpm-tier-ico {
  width: 68rpx; height: 68rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}
.ll-cpm-tier-ico--refund  { background: #E6F1EC; }
.ll-cpm-tier-ico--partial { background: #FEF3C7; }
.ll-cpm-tier-ico--multi   { background: #E3EEF7; }
.ll-cpm-tier-text {
  flex: 1;
  padding-top: 4rpx;
  display: flex; flex-direction: column;
}
.ll-cpm-tier-label {
  font-size: 27rpx; font-weight: 700; color: var(--ll-text);
  margin-bottom: 8rpx;
}
.ll-cpm-tier-detail {
  font-size: 25rpx; color: var(--ll-text-2);
  line-height: 1.65;
}

.ll-cpm-actions { padding: 36rpx 40rpx 48rpx; }
.ll-cpm-confirm {
  height: 100rpx; border-radius: 999rpx;
  background: #E63946; color: var(--ll-text-on-ink);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
  letter-spacing: 0.04em;
}
.ll-cpm-cancel {
  height: 80rpx;
  margin-top: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; color: var(--ll-text-3);
}
