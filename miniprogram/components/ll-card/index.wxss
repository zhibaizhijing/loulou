.ll-card {
  background: var(--ll-surface);
  border-radius: var(--ll-radius-lg);
  box-shadow: var(--ll-shadow-card);
  box-sizing: border-box;
}
.ll-card.pad-none   { padding: 0; }
.ll-card.pad-tight  { padding: 16rpx 20rpx; }
.ll-card.pad-normal { padding: 28rpx 32rpx; }
.ll-card.pad-loose  { padding: 40rpx 36rpx; }
.ll-card.is-flat    { box-shadow: none; }
