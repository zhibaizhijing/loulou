.ll-ring-wrap { position: relative; display: inline-block; }
.ll-ring-svg  { display: block; }
.ll-ring-center {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ll-ring-pct    { font-size: 60rpx; font-weight: 700; color: var(--ll-text); letter-spacing: -0.02em; }
.ll-ring-target { font-size: 26rpx; color: var(--ll-text-2); margin-top: 4rpx; }
