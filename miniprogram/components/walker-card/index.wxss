.wc-card {
  display: flex; gap: 24rpx;
  padding: 24rpx;
  background: var(--ll-surface);
  border-radius: var(--ll-radius-lg);
  box-shadow: var(--ll-shadow-card);
}
.wc-card-hover { background: var(--ll-surface-2); }
.wc-avatar {
  width: 128rpx; height: 128rpx; border-radius: 28rpx;
  background: var(--ll-butter);
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.wc-avatar-img { width: 100%; height: 100%; }
.wc-body { flex: 1; display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.wc-row-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.wc-name { font-size: 32rpx; font-weight: 700; color: var(--ll-text); }
.wc-areas { display: flex; gap: 8rpx; flex-wrap: wrap; }
.wc-area {
  font-size: 22rpx; font-weight: 600;
  padding: 4rpx 16rpx;
  background: var(--ll-lavender);
  color: var(--ll-text);
  border-radius: var(--ll-radius-xs);
}
.wc-row-btm { display: flex; align-items: baseline; gap: 6rpx; margin-top: 4rpx; }
.wc-price { font-size: 30rpx; font-weight: 700; color: var(--ll-text); }
.wc-price-unit { font-size: 22rpx; color: var(--ll-text-3); }
