<view class="ll-tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="path"
    class="ll-tab {{activePath === item.path ? 'is-on' : ''}}"
    data-path="{{item.path}}"
    bindtap="onTap"
  >
    <view class="ll-tab-icon">
      <ll-icon
        name="{{item.icon}}"
        weight="{{activePath === item.path ? 'fill' : 'regular'}}"
        size="44"
        color="{{activePath === item.path ? '#1E1E24' : '#A0A0B0'}}"
      />
      <view
        wx:if="{{(item.badgeKey === 'loulou:badge:orders' && badges.orders) || (item.badgeKey === 'loulou:badge:chat' && badges.chat)}}"
        class="ll-tab-dot"
      ></view>
    </view>
    <view class="ll-tab-label">{{item.label}}</view>
  </view>
</view>
