.ll-tabbar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 156rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: var(--ll-surface, #fff);
  border-top: 1px solid var(--ll-border, #EEEEF2);
  z-index: 100;
}
.ll-tab {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 6rpx;
  color: var(--ll-text-3, #A0A0B0);
}
.ll-tab.is-on { color: var(--ll-text, #1E1E24); }
.ll-tab-icon { line-height: 1; position: relative; }
.ll-tab-dot {
  position: absolute; top: -4rpx; right: -6rpx;
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #E63946;
  border: 3rpx solid var(--ll-surface, #fff);
}
.ll-tab-label {
  font-size: 21rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.ll-tab.is-on .ll-tab-label { font-weight: 600; }
