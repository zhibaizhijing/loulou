<view class="ll-page ab-page">
  <ll-topnav title="关于 Loulou"/>

  <!-- App info -->
  <view class="ab-info">
    <view class="ab-logo">
      <ll-icon name="paw-print" weight="fill" size="72" color="#22282C"/>
    </view>
    <view class="ab-name">Loulou 噜噜</view>
    <view class="ab-sub">宠物守护服务平台</view>
    <view class="ab-version">版本 1.2.0</view>
  </view>

  <view class="ab-band"></view>

  <!-- Doc list -->
  <view class="ab-docs">
    <view wx:for="{{docs}}" wx:key="id">
      <view class="ab-doc-head" data-id="{{item.id}}" bindtap="onToggle">
        <text class="ab-doc-label">{{item.label}}</text>
        <ll-icon name="{{(item.body && expanded === item.id) ? 'caret-up' : 'caret-right'}}" size="24" color="#A0A0B0"/>
      </view>
      <view wx:if="{{item.body && expanded === item.id}}" class="ab-doc-body">
        <text>{{item.body}}</text>
      </view>
    </view>
  </view>

  <view class="ab-footer">
    <text class="ab-copy">© 2026 Loulou 噜噜 版权所有</text>
    <text class="ab-icp">京 ICP 备 2026XXXXXX 号</text>
  </view>
</view>
