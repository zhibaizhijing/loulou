.me-page { padding-bottom: 192rpx; }

/* ─── Profile card ─── */
.me-profile {
  background: var(--ll-surface);
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.me-avatar {
  width: 172rpx; height: 172rpx; border-radius: 50%;
  background: #D4D4DE;
  margin-bottom: 24rpx;
  overflow: hidden;
  position: relative;
}
.me-avatar-head {
  position: absolute;
  top: 22rpx; left: 50%;
  margin-left: -36rpx;
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: #A0A0B8;
}
.me-avatar-body {
  position: absolute;
  bottom: -60rpx; left: 50%;
  margin-left: -80rpx;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: #A0A0B8;
}
.me-name {
  font-size: 44rpx; font-weight: 800;
  color: var(--ll-text); letter-spacing: -0.01em;
  margin-bottom: 10rpx;
}
.me-loc  {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--ll-text-2);
  margin-bottom: 36rpx;
}
.me-edit-cta {
  width: 100%;
  height: 92rpx;
  border-radius: var(--ll-radius-pill);
  background: var(--ll-ink);
  color: var(--ll-text-on-ink);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

/* ─── Tabs ─── */
.me-tabs {
  display: flex;
  flex-direction: row;
  background: var(--ll-surface);
  border-bottom: 1px solid var(--ll-border);
}
.me-tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: var(--ll-text-3);
  font-weight: 500;
  border-bottom: 4rpx solid transparent;
  box-sizing: border-box;
}
.me-tab-item.is-on {
  color: var(--ll-text);
  font-weight: 700;
  border-bottom-color: var(--ll-text);
}

.me-tab-body { background: var(--ll-surface); padding: 32rpx; }

/* About */
.me-about-joined {
  display: flex; flex-direction: row; align-items: center; gap: 24rpx;
  padding: 8rpx 0 32rpx;
  font-size: 27rpx; color: var(--ll-text-2);
}
.me-section-divider { height: 1px; background: var(--ll-border); margin-bottom: 32rpx; }
.me-about-head { font-size: 28rpx; font-weight: 700; color: var(--ll-text); margin-bottom: 24rpx; }
.me-verify-row {
  display: flex; flex-direction: row; align-items: center; gap: 24rpx;
  padding: 12rpx 0;
  font-size: 27rpx; color: var(--ll-text-2);
}

/* Feedback */
.me-feedback-head { font-size: 34rpx; font-weight: 700; color: var(--ll-text); margin-bottom: 16rpx; }
.me-feedback-desc { font-size: 26rpx; color: var(--ll-text-2); line-height: 1.65; margin-bottom: 56rpx; }
.me-feedback-empty {
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
  padding: 24rpx 0;
}
.me-feedback-empty text { font-size: 27rpx; color: var(--ll-text-3); }

/* Pets */
.me-pets-head { font-size: 34rpx; font-weight: 700; color: var(--ll-text); margin-bottom: 16rpx; }
.me-pets-desc { font-size: 26rpx; color: var(--ll-text-2); line-height: 1.65; margin-bottom: 40rpx; }
.me-pet-list  { display: flex; flex-direction: column; }
.me-pet {
  display: flex; flex-direction: row; align-items: center; gap: 28rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--ll-border);
}
.me-pet:last-child { border-bottom: 0; }
.me-pet-avatar {
  width: 104rpx; height: 104rpx; border-radius: 50%;
  flex: 0 0 auto;
  display: flex; flex-direction: row; align-items: center; justify-content: center;
}
.me-pet-avatar--butter   { background: var(--ll-butter); }
.me-pet-avatar--lavender { background: var(--ll-lavender); }
.me-pet-body  { flex: 1; min-width: 0; }
.me-pet-name  { font-size: 29rpx; font-weight: 700; color: var(--ll-text); margin-bottom: 4rpx; }
.me-pet-breed { font-size: 25rpx; color: var(--ll-text-2); }
.me-pets-empty { padding: 24rpx 0; text-align: center; font-size: 26rpx; color: var(--ll-text-3); }

.me-add-pet {
  margin-top: 32rpx;
  display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12rpx;
  width: 100%; height: 88rpx;
  border-radius: var(--ll-radius-pill);
  background: transparent;
  box-shadow: inset 0 0 0 2rpx var(--ll-border);
  font-size: 27rpx; color: var(--ll-text-2); font-weight: 600;
  box-sizing: border-box;
}

.me-band { height: 16rpx; background: var(--ll-bg); }
.me-menu { background: var(--ll-surface); }
