.bk-page { padding-bottom: 320rpx; }
.bk-body { padding: 0 0 32rpx; }

.bk-pay-pill {
  margin: 16rpx var(--ll-safe-x) 0;
  display: inline-flex; align-items: center; gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: var(--ll-radius-pill);
  font-size: 26rpx; font-weight: 600; color: var(--ll-text);
}
.bk-pay-pill--unpaid   { background: var(--ll-butter); }
.bk-pay-pill--held     { background: var(--ll-mint-soft); }
.bk-pay-pill--released { background: var(--ll-mint); }
.bk-pay-pill--refunded { background: var(--ll-lavender); }

.bk-section { padding: 16rpx var(--ll-safe-x) 0; }
.bk-row {
  display: flex; justify-content: space-between; align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 1px solid var(--ll-border);
}
.bk-row:last-child { border-bottom: 0; }
.bk-row-key { font-size: 24rpx; color: var(--ll-text-2); }
.bk-row-val { font-size: 28rpx; font-weight: 600; color: var(--ll-text); }

.bk-walker { display: flex; align-items: center; gap: 24rpx; }
.bk-walker-avatar {
  width: 96rpx; height: 96rpx; border-radius: 28rpx;
  background: var(--ll-butter);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.bk-walker-img  { width: 100%; height: 100%; }
.bk-walker-meta { flex: 1; }
.bk-walker-name { font-size: 30rpx; font-weight: 700; color: var(--ll-text); }

.bk-report-notes  { font-size: 26rpx; line-height: 1.6; color: var(--ll-text); }
.bk-report-photos { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 16rpx; }
.bk-report-photo  { width: 200rpx; height: 200rpx; border-radius: var(--ll-radius-md); }
.bk-report-counts { font-size: 24rpx; color: var(--ll-text-2); margin-top: 16rpx; }

.bk-stickybar,
.bs-stickybar {
  position: fixed;
  bottom: env(safe-area-inset-bottom);
  left: 0; right: 0;
  padding: 16rpx var(--ll-safe-x);
  background: var(--ll-surface);
  display: flex; flex-direction: column; gap: 12rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 50;
}
.bs-cta-row {
  display: flex; gap: 16rpx; flex-wrap: wrap;
}
.bs-cta-row ll-cta { flex: 1; min-width: 0; }
.bs-cta-inner {
  display: inline-flex; align-items: center; gap: 8rpx;
  font-size: 26rpx; font-weight: 700;
}

/* v3 audit — order-no + support sheet */
.bs-nav-support {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: rgba(34,40,44,0.06);
  display: flex; align-items: center; justify-content: center;
}
.bs-orderno {
  margin: 16rpx var(--ll-safe-x) 0;
  padding: 20rpx 28rpx;
  background: var(--ll-surface);
  border-radius: 24rpx;
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.bs-orderno-label { font-size: 24rpx; color: var(--ll-text-3); }
.bs-orderno-value {
  flex: 1;
  font-size: 26rpx; font-weight: 700; color: var(--ll-text);
  letter-spacing: 0.04em;
}
.bs-orderno-copy {
  font-size: 24rpx; font-weight: 600;
  color: var(--ll-text-2);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(34,40,44,0.06);
}

.bs-support-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.42);
  z-index: 95;
}
.bs-support-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 96;
  background: var(--ll-surface);
  border-top-left-radius: 40rpx; border-top-right-radius: 40rpx;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.bs-support-grab {
  width: 76rpx; height: 8rpx; border-radius: 4rpx;
  background: var(--ll-border);
  margin: 0 auto 20rpx;
}
.bs-support-title {
  text-align: center;
  font-size: 30rpx; font-weight: 700;
  color: var(--ll-text);
  margin-bottom: 24rpx;
}
.bs-support-row {
  display: flex; align-items: center; gap: 24rpx;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid var(--ll-border);
}
.bs-support-ico {
  width: 76rpx; height: 76rpx; border-radius: 20rpx;
  background: var(--ll-bg);
  display: flex; align-items: center; justify-content: center;
}
.bs-support-info { display: flex; flex-direction: column; gap: 4rpx; }
.bs-support-lbl { font-size: 28rpx; font-weight: 700; color: var(--ll-text); }
.bs-support-sub { font-size: 22rpx; color: var(--ll-text-3); }
.bs-support-cancel {
  margin-top: 20rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: var(--ll-bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600;
  color: var(--ll-text);
}
