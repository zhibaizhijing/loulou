<mock-banner />

<view wx:if="{{phase === 'form'}}" class="page">
  <view class="progress">Step {{step}} of {{totalSteps}}</view>
  <view class="progress-bar"><view class="progress-fill" style="width: {{(step * 100) / totalSteps}}%"></view></view>

  <view wx:if="{{step === 1}}" class="section">
    <view class="label">Your real name</view>
    <t-input placeholder="Enter your full name" model:value="{{realName}}" bind:change="onFieldChange" />
  </view>

  <view wx:if="{{step === 2}}" class="section">
    <view class="label">Government ID photo</view>
    <view class="hint">Used for identity verification (mock — not stored anywhere real).</view>
    <view wx:if="{{idPhotoUrl}}" class="thumb-wrap">
      <image src="{{idPhotoUrl}}" mode="aspectFill" class="thumb-id" />
    </view>
    <t-button bindtap="onPickIdPhoto">{{idPhotoUrl ? 'Replace photo' : '+ Add ID photo'}}</t-button>
  </view>

  <view wx:if="{{step === 3}}" class="section">
    <view class="label">Photos of where pets will stay (1-3)</view>
    <view class="thumb-grid">
      <image wx:for="{{indoorPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="thumb-grid-item" />
    </view>
    <t-button wx:if="{{indoorPhotos.length < 3}}" bindtap="onPickIndoorPhotos">+ Add photo ({{indoorPhotos.length}}/3)</t-button>
  </view>

  <view wx:if="{{step === 4}}" class="section">
    <view class="label">About you</view>
    <t-textarea placeholder="Tell pet owners about your experience, home setup, etc. (min 10 chars)" model:value="{{bio}}" bind:change="onFieldChange" />
    <view class="label" style="margin-top:24rpx">Services you'll offer</view>
    <t-checkbox-group value="{{proposedServiceTypes}}" bind:change="onServicesChange">
      <t-checkbox wx:for="{{serviceOptions}}" wx:key="value" value="{{item.value}}" label="{{item.label}}" />
    </t-checkbox-group>
  </view>

  <view wx:if="{{step === 5}}" class="section">
    <view class="label">What pets you accept</view>
    <view class="hint">Owners use these as search filters.</view>

    <view class="sub-label">Pet types</view>
    <t-checkbox-group value="{{acceptedPetTypes}}" bind:change="onPetTypesChange">
      <t-checkbox wx:for="{{petTypeOptions}}" wx:key="value" value="{{item.value}}" label="{{item.label}}" />
    </t-checkbox-group>

    <view class="sub-label">Size bands</view>
    <t-checkbox-group value="{{acceptedSizeBands}}" bind:change="onSizeBandsChange">
      <t-checkbox wx:for="{{sizeBandOptions}}" wx:key="value" value="{{item.value}}" label="{{item.label}}" />
    </t-checkbox-group>

    <view class="sub-label">Max pets at a time</view>
    <t-stepper value="{{maxConcurrent}}" min="{{1}}" max="{{5}}" bind:change="onMaxConcurrentChange" />

    <view class="sub-label">Care capabilities</view>
    <view class="switch-row">
      <view>Can administer medication</view>
      <t-switch value="{{canMedicate}}" bind:change="onCanMedicateChange" />
    </view>
    <view class="switch-row">
      <view>Accepts puppies (&lt;6 months)</view>
      <t-switch value="{{acceptsPuppy}}" bind:change="onAcceptsPuppyChange" />
    </view>
    <view class="switch-row">
      <view>Accepts seniors (&gt;10 years)</view>
      <t-switch value="{{acceptsSenior}}" bind:change="onAcceptsSeniorChange" />
    </view>
    <view class="switch-row">
      <view>Accepts aggressive / reactive pets</view>
      <t-switch value="{{acceptsAggressive}}" bind:change="onAcceptsAggressiveChange" />
    </view>

    <view class="sub-label">Notes (optional, ≤200 chars)</view>
    <t-textarea placeholder="Any specifics owners should know" model:value="{{intakeNotes}}" maxlength="{{200}}" />
  </view>

  <view wx:if="{{step === 6}}" class="section">
    <view class="label">Review your application</view>
    <view class="review-row"><text class="rk">Name</text><text>{{realName}}</text></view>
    <view class="review-row"><text class="rk">Bio</text><text>{{bio}}</text></view>
    <view class="review-row">
      <text class="rk">Services</text>
      <view>
        <t-tag wx:for="{{proposedServiceTypes}}" wx:key="*this" style="margin-right:8rpx">{{serviceLabels[item]}}</t-tag>
      </view>
    </view>
    <view class="review-row">
      <text class="rk">Pet types</text>
      <view>
        <t-tag wx:for="{{acceptedPetTypes}}" wx:key="*this" style="margin-right:8rpx">{{petTypeLabels[item]}}</t-tag>
      </view>
    </view>
    <view class="review-row">
      <text class="rk">Sizes</text>
      <view>
        <t-tag wx:for="{{acceptedSizeBands}}" wx:key="*this" style="margin-right:8rpx">{{sizeBandLabels[item]}}</t-tag>
      </view>
    </view>
    <view class="review-row"><text class="rk">Max at once</text><text>{{maxConcurrent}}</text></view>
    <view class="review-row"><text class="rk">Can medicate</text><text>{{canMedicate ? 'Yes' : 'No'}}</text></view>
    <view class="review-row"><text class="rk">Puppies</text><text>{{acceptsPuppy ? 'Yes' : 'No'}}</text></view>
    <view class="review-row"><text class="rk">Seniors</text><text>{{acceptsSenior ? 'Yes' : 'No'}}</text></view>
    <view wx:if="{{intakeNotes}}" class="review-row"><text class="rk">Notes</text><text>{{intakeNotes}}</text></view>
    <view class="review-row"><text class="rk">ID photo</text><image src="{{idPhotoUrl}}" mode="aspectFill" class="thumb-id" /></view>
    <view class="review-row"><text class="rk">Indoor photos</text>
      <view class="thumb-grid">
        <image wx:for="{{indoorPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="thumb-grid-item" />
      </view>
    </view>
  </view>

  <view class="nav-buttons">
    <t-button wx:if="{{step > 1}}" variant="outline" bindtap="onBack">Back</t-button>
    <t-button wx:if="{{step < totalSteps}}" theme="primary" bindtap="onNext">Next</t-button>
    <t-button wx:if="{{step === totalSteps}}" theme="primary" loading="{{submitting}}" bindtap="onSubmit">Submit application</t-button>
  </view>
</view>

<view wx:if="{{phase === 'status'}}" class="page status-page">
  <view class="status-card">
    <view class="status-icon">{{statusIcon}}</view>
    <view class="status-title">{{statusTitle}}</view>
    <view class="status-sub">{{statusSub}}</view>
    <loading-skeleton wx:if="{{application.status === 'submitted' || application.status === 'reviewing'}}" count="2" />
    <t-button wx:if="{{application.status === 'approved'}}" theme="primary" block bindtap="onSwitchToCaregiver">Switch to caregiver mode</t-button>
    <t-button wx:if="{{application.status === 'approved'}}" variant="outline" block bindtap="onBackHome">Back to home</t-button>
  </view>
</view>
