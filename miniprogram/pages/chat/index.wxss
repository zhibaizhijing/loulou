.chat-page { padding-bottom: 160rpx; }

/* ─── Messages (thread list) header ─── */
.ml-hdr { background: var(--ll-surface); box-shadow: 0 1px 0 rgba(0,0,0,0.06); }
.ml-hdr-title-row { height: 104rpx; display: flex; align-items: center; padding: 0 32rpx; }
.ml-hdr-spacer    { width: 72rpx; flex: 0 0 auto; }
.ml-hdr-title     { flex: 1; text-align: center; font-size: 34rpx; font-weight: 700; color: var(--ll-text); letter-spacing: -0.01em; }
.ml-hdr-actions   {
  display: flex; justify-content: flex-end;
  padding: 0 24rpx 20rpx; gap: 16rpx;
}
.ml-hdr-iconbtn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(34,40,44,0.06);
  display: flex; align-items: center; justify-content: center;
}

/* ─── Thread list ─── */
.ml-list { padding: 16rpx 32rpx 0; display: flex; flex-direction: column; gap: 16rpx; }
.ml-thread {
  display: flex; align-items: center; gap: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--ll-surface);
  border-radius: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  position: relative;
}
.ml-thread-hover { background: var(--ll-surface-2); }
.ml-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  position: relative;
}
.ml-avatar--butter   { background: var(--ll-butter); }
.ml-avatar--lavender { background: var(--ll-lavender); }
.ml-avatar--mint     { background: var(--ll-mint); }
.ml-avatar--peach    { background: var(--ll-peach); }
.ml-avatar--ink      { background: var(--ll-ink); }
.ml-avatar-img       { width: 100%; height: 100%; }
.ml-avatar-init      { font-size: 36rpx; font-weight: 700; color: var(--ll-text); }
.ml-avatar--ink .ml-avatar-init { color: #fff; }
.ml-avatar-wrap {
  position: relative;
  flex: 0 0 auto;
  width: 96rpx; height: 96rpx;
}
.ml-avatar-wrap .ml-avatar { width: 96rpx; height: 96rpx; }
.ml-live-dot {
  position: absolute;
  top: 4rpx; right: 4rpx;
  width: 24rpx; height: 24rpx; border-radius: 50%;
  background: #2C7A4B;
  border: 4rpx solid #fff;
  z-index: 2;
}

.ml-body { flex: 1; min-width: 0; }
.ml-thread-top {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 6rpx;
}
.ml-thread-name {
  font-size: 28rpx; font-weight: 600; color: var(--ll-text);
  flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.ml-thread-name.is-unread { font-weight: 700; }
.ml-thread-time { font-size: 22rpx; color: var(--ll-text-3); }
.ml-thread-last {
  font-size: 25rpx; color: var(--ll-text-3);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  font-weight: 400;
}
.ml-thread-last.is-unread { color: var(--ll-text-2); font-weight: 500; }

/* v3 — order-tag chip below thread name (design MessagesScreen §4.1). */
.ml-thread-order-tag {
  display: inline-flex; align-items: center; gap: 8rpx;
  background: #EAF3EE; color: #2C7A4B;
  border-radius: 12rpx;
  padding: 2rpx 14rpx;
  font-size: 21rpx; font-weight: 600;
  margin: 8rpx 0;
  align-self: flex-start;
}
.ml-thread-order-tag.is-done {
  background: #F0F0F5; color: var(--ll-text-3);
}
/* v3 audit — static demo threads render at full opacity per design MessagesScreen. */
.ml-thread.is-static { opacity: 1; }
.ml-unread {
  min-width: 36rpx; height: 36rpx;
  padding: 0 10rpx; border-radius: 18rpx;
  background: var(--ll-heart); color: #fff;
  font-size: 21rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}

/* ─── ChatView (v2 spec §2.10) ─── */
.cv-shell {
  position: fixed;
  inset: 0;
  display: flex; flex-direction: column;
  background: var(--ll-bg);
  z-index: 5;
  padding-bottom: 156rpx; /* room above custom tab bar */
}
.cv-topnav {
  flex: 0 0 auto;
  height: 104rpx;
  background: var(--ll-surface);
  border-bottom: 1px solid var(--ll-border);
  display: flex; align-items: center;
  padding: 0 28rpx; gap: 24rpx;
}
.cv-back {
  width: 68rpx; height: 68rpx; border-radius: 50%;
  background: var(--ll-ink);
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}
.cv-who { flex: 1; display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.cv-who-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--ll-lavender);
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}
.cv-who-img  { width: 100%; height: 100%; }
.cv-who-char { font-size: 28rpx; font-weight: 700; color: var(--ll-text); }
.cv-who-text { display: flex; flex-direction: column; line-height: 1.2; }
.cv-who-name { font-size: 28rpx; font-weight: 700; color: var(--ll-text); }
.cv-who-role { font-size: 22rpx; color: var(--ll-text-3); }

/* Application card */
.cv-app-wrap {
  background: var(--ll-surface);
  padding: 20rpx 28rpx 0;
}
.cv-app {
  background: var(--ll-bg);
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  display: flex; align-items: center; gap: 24rpx;
}
.cv-app-ico {
  width: 80rpx; height: 80rpx; border-radius: 20rpx;
  background: var(--ll-butter);
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}
.cv-app-info { flex: 1; min-width: 0; }
.cv-app-line { display: block; font-size: 26rpx; font-weight: 700; color: var(--ll-text); }
.cv-app-sub  { font-size: 23rpx; color: var(--ll-text-3); margin-top: 4rpx; }

/* Shortcut row */
.cv-short {
  background: var(--ll-surface);
  padding: 20rpx 28rpx;
  border-bottom: 1px solid var(--ll-border);
  display: flex; gap: 16rpx;
}

/* Messages scroll area */
.cv-messages {
  flex: 1;
  padding: 28rpx 28rpx 16rpx;
  background: var(--ll-bg);
  min-height: 0;
}

/* Quick reply */
.cv-qr {
  background: var(--ll-surface);
  border-top: 1px solid var(--ll-border);
  padding: 16rpx 28rpx 0;
}

/* Input bar */
.cv-input-wrap {
  background: var(--ll-surface);
  position: relative;
  padding-bottom: env(safe-area-inset-bottom);
}
.cv-input-row {
  padding: 16rpx 28rpx 56rpx;
  display: flex; align-items: center; gap: 20rpx;
}
.cv-input {
  flex: 1; height: 80rpx;
  padding: 0 28rpx;
  background: var(--ll-bg);
  border: 1px solid var(--ll-border);
  border-radius: 999rpx;
  font-size: 28rpx; color: var(--ll-text);
}
.cv-send {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: var(--ll-border);
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
  transition: background var(--ll-dur-fast) var(--ll-ease);
}
.cv-send.is-on { background: var(--ll-ink); }
.cv-plus-btn {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: var(--ll-surface);
  border: 3rpx solid var(--ll-border);
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}

/* Plus popup menu */
.cv-plus-mask {
  position: fixed; inset: 0; z-index: 10;
}
.cv-plus-menu {
  position: absolute; bottom: calc(100% + 12rpx); right: 28rpx; z-index: 20;
  background: var(--ll-surface);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.13);
  min-width: 280rpx;
}
.cv-plus-item {
  width: 100%; padding: 26rpx 32rpx;
  display: flex; align-items: center; gap: 24rpx;
  border-bottom: 1px solid var(--ll-border);
  font-size: 28rpx; color: var(--ll-text);
}
.cv-plus-item:last-child { border-bottom: 0; }
.cv-plus-tile {
  width: 64rpx; height: 64rpx; border-radius: 18rpx;
  background: var(--ll-bg);
  display: flex; align-items: center; justify-content: center;
}
