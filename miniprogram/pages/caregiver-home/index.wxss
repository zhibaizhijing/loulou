.ch-page { padding-bottom: 192rpx; }
.ch-body { padding: 24rpx 0; }

.ch-hero {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx var(--ll-safe-x) 0;
}
.ch-hero-avatar {
  width: 128rpx; height: 128rpx; border-radius: 28rpx;
  background: var(--ll-butter);
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto; overflow: hidden;
}
.ch-hero-img  { width: 100%; height: 100%; }
.ch-hero-meta { flex: 1; min-width: 0; }
.ch-hero-tags { margin-top: 8rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.ch-svc-tag {
  font-size: 20rpx; font-weight: 600;
  padding: 4rpx 16rpx;
  background: var(--ll-mint-soft);
  color: var(--ll-text);
  border-radius: var(--ll-radius-xs);
}

.ch-stats {
  display: flex; gap: 16rpx;
  padding: 16rpx var(--ll-safe-x);
}
.ch-menu { background: var(--ll-surface); margin-top: 24rpx; }
.ch-exit { padding: 32rpx var(--ll-safe-x); }
