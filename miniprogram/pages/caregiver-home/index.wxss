.page { padding:16rpx; padding-bottom: 200rpx; }
.hero { display:flex; gap:20rpx; padding:24rpx; background:#fff; border-radius:16rpx; margin-bottom:16rpx; align-items:center; }
.avatar { width:120rpx; height:120rpx; border-radius:60rpx; background:#eee; flex-shrink:0; }
.meta { display:flex; flex-direction:column; gap:8rpx; }
.name { font-size:32rpx; font-weight:600; }
.rating { font-size:24rpx; color:#f59e0b; }
.tags { display:flex; flex-wrap:wrap; }
.card { background:#fff; padding:24rpx; border-radius:12rpx; margin-bottom:12rpx; display:flex; flex-direction:column; gap:8rpx; }
.card-title { font-size:24rpx; color:#888; }
.card-value { font-size:48rpx; font-weight:600; color:#1f2329; }
.card-sub { font-size:22rpx; color:#2563eb; }
.actions { margin-top:24rpx; }
