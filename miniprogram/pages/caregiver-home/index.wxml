<mock-banner />

<empty-state wx:if="{{noCaregiver}}" icon="🚫" title="Not in caregiver mode" subtitle="Use the Me tab to apply or switch into a caregiver." ctaText="Back to Me" bind:cta="onBackToMe" />

<view wx:elif="{{loading}}" class="page">
  <loading-skeleton count="5" />
</view>

<view wx:else class="page">
  <view class="hero">
    <image class="avatar" src="{{caregiver.avatar || 'data:image/png;base64,iVBORw0KGgo='}}" mode="aspectFill" />
    <view class="meta">
      <view class="name">{{caregiver.name}}</view>
      <view class="rating">★ {{caregiver.rating}} ({{caregiver.reviewCount}} reviews)</view>
      <view class="tags">
        <t-tag wx:for="{{caregiver.serviceTypes}}" wx:key="*this" style="margin-right:8rpx">{{labels[item]}}</t-tag>
      </view>
    </view>
  </view>

  <view class="card" bindtap="onOpenInbox">
    <view class="card-title">Pending bookings</view>
    <view class="card-value">{{pendingCount}}</view>
    <view class="card-sub">{{pendingCount === 0 ? 'No new requests' : 'Tap to review →'}}</view>
  </view>

  <view class="card" bindtap="onManageServices">
    <view class="card-title">Active services</view>
    <view class="card-value">{{activeServicesCount}}</view>
    <view class="card-sub">Tap to manage →</view>
  </view>

  <view class="card" bindtap="onOpenCalendar">
    <view class="card-title">This month — blocked days</view>
    <view class="card-value">{{blockedThisMonth}}</view>
    <view class="card-sub">Tap to edit availability →</view>
  </view>

  <view class="actions">
    <t-button block variant="outline" bindtap="onExitMode">Exit caregiver mode</t-button>
  </view>
</view>
