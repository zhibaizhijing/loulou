.om-page { padding: 0 0 240rpx; min-height: 100vh; background: var(--ll-bg); }
.om-section {
  background: var(--ll-surface);
  margin: 24rpx 32rpx 0;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: var(--ll-shadow-card);
}
.om-section--note { padding-bottom: 36rpx; }
.om-label {
  display: block;
  font-size: 26rpx; font-weight: 600; color: var(--ll-text-2);
  margin-bottom: 20rpx;
}
.om-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.om-chip {
  height: 64rpx; padding: 0 28rpx;
  border-radius: 999rpx;
  background: #F5F5FA;
  color: var(--ll-text-2);
  font-size: 26rpx; font-weight: 500;
  display: flex; align-items: center; justify-content: center;
}
.om-chip.is-on {
  background: var(--ll-ink);
  color: var(--ll-text-on-ink);
  font-weight: 700;
}
.om-row {
  display: flex; align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--ll-border);
}
.om-row.is-last { border-bottom: 0; }
.om-row-label { flex: 1; font-size: 28rpx; color: var(--ll-text); }
.om-row-value { font-size: 28rpx; color: var(--ll-text-2); margin-right: 12rpx; }
.om-textarea {
  width: 100%;
  min-height: 220rpx;
  background: var(--ll-bg);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx; color: var(--ll-text);
}
.om-placeholder { color: var(--ll-text-3); }
.om-footer {
  position: fixed; left: 0; right: 0;
  bottom: env(safe-area-inset-bottom);
  padding: 24rpx 32rpx 36rpx;
  background: var(--ll-bg);
}
