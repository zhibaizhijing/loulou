.page { padding:16rpx; }
.card { background:#fff; border-radius:12rpx; padding:24rpx; margin-bottom:16rpx; display:flex; flex-direction:column; gap:16rpx; }
.row { display:flex; justify-content:space-between; align-items:center; }
.title { font-size:30rpx; font-weight:500; }
.price { font-size:28rpx; color:#16a34a; }
.actions { display:flex; gap:8rpx; }
