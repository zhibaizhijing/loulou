.act-page { padding: 0 0 192rpx; }

.act-head {
  display: flex; align-items: center;
  padding: 24rpx var(--ll-safe-x) 0;
}
.act-title { font-size: 44rpx; font-weight: 700; color: var(--ll-text); letter-spacing: -0.01em; }
.act-iconbtn {
  margin-left: auto;
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(34, 40, 44, 0.06);
  display: flex; align-items: center; justify-content: center;
}

.act-sub { padding: 24rpx var(--ll-safe-x) 0; font-size: 28rpx; color: var(--ll-text-2); }

.act-stats {
  display: flex; gap: 24rpx;
  padding: 20rpx var(--ll-safe-x) 0;
}

.act-progress-card {
  margin: 36rpx var(--ll-safe-x) 0;
  background: var(--ll-surface);
  border-radius: 40rpx;
  padding: 40rpx 32rpx 48rpx;
  box-shadow: var(--ll-shadow-card);
}
.act-progress-title { font-size: 32rpx; font-weight: 700; color: var(--ll-text); }
.act-progress-ring  { margin-top: 24rpx; display: flex; justify-content: center; }

.act-cta { padding: 36rpx var(--ll-safe-x) 0; }

.act-history {
  margin: 28rpx auto 0;
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx; font-weight: 500; color: var(--ll-text);
  border-bottom: 1px solid var(--ll-border);
  text-align: center;
}
.act-page { text-align: center; }
.act-head, .act-sub, .act-stats, .act-progress-card, .act-cta { text-align: left; }
