.page { padding: 16rpx; }
.balance-card { background:#fff; padding:32rpx; border-radius:12rpx; text-align:center; }
.balance-label { font-size:24rpx; color:#888; }
.balance-amount { font-size:64rpx; font-weight:700; color:#16a34a; margin:16rpx 0; }
.balance-hint { font-size:22rpx; color:#888; }
.totals { background:#fff; padding:16rpx 24rpx; border-radius:12rpx; margin-top:16rpx; }
.total-row { display:flex; justify-content:space-between; padding:12rpx 0; font-size:26rpx; }
.pos { color:#16a34a; }
.neg { color:#dc2626; }
.ledger-label { padding:24rpx 8rpx 12rpx; font-size:24rpx; color:#888; text-transform:uppercase; }
.ledger-row { display:flex; justify-content:space-between; align-items:center; background:#fff; padding:16rpx 24rpx; border-radius:8rpx; margin-bottom:8rpx; }
.ledger-main { display:flex; flex-direction:column; gap:4rpx; }
.ledger-kind { font-size:26rpx; color:#1f2329; }
.ledger-date { font-size:22rpx; color:#888; }
.ledger-amount { font-size:28rpx; font-weight:600; }
