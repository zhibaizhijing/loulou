.ce-page { padding-bottom: 192rpx; }
.ce-body { padding: 24rpx 0; }

.ce-balance {
  margin: 16rpx var(--ll-safe-x) 0;
  padding: 48rpx 32rpx;
  background: var(--ll-ink);
  border-radius: var(--ll-radius-lg);
  text-align: center;
  color: var(--ll-text-on-ink);
  box-shadow: var(--ll-shadow-card);
}
.ce-balance-label  { font-size: 24rpx; color: rgba(255,255,255,0.6); }
.ce-balance-amount { font-size: 80rpx; font-weight: 800; color: #FEE7A6; margin: 16rpx 0; letter-spacing: -0.01em; }
.ce-balance-hint   { font-size: 22rpx; color: rgba(255,255,255,0.55); }

.ce-stats {
  display: flex; gap: 16rpx;
  padding: 16rpx var(--ll-safe-x);
}

.ce-section { padding: 16rpx var(--ll-safe-x); background: var(--ll-surface); }
.ce-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--ll-border);
}
.ce-row:last-child { border-bottom: 0; }
.ce-row-main   { display: flex; flex-direction: column; gap: 4rpx; }
.ce-row-kind   { font-size: 26rpx; color: var(--ll-text); font-weight: 500; }
.ce-row-date   { font-size: 22rpx; color: var(--ll-text-3); }
.ce-row-amount { font-size: 28rpx; font-weight: 700; }
.ce-row-amount.is-pos { color: var(--ll-success); }
.ce-row-amount.is-neg { color: var(--ll-text); }
