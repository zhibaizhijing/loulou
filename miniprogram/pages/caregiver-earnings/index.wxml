<view class="ll-page ce-page">
  <mock-banner />
  <ll-topnav title="收益"/>

  <empty-state wx:if="{{noCaregiver}}" icon="🚫" title="未进入守护者模式" />

  <view wx:else class="ce-body">
    <loading-skeleton wx:if="{{loading}}" count="4" />

    <view wx:else>
      <!-- Balance hero -->
      <view class="ce-balance">
        <view class="ce-balance-label">净余额</view>
        <view class="ce-balance-amount ll-num">¥{{balance}}</view>
        <view class="ce-balance-hint">资金已结算至您的钱包（示例数据 · 非真实交易）</view>
      </view>

      <!-- Stat tiles -->
      <view class="ce-stats">
        <ll-stat-tile label="收到"    value="{{totalCredited}}"  unit="¥" bg="butter"/>
        <ll-stat-tile label="平台佣金" value="{{totalCommission}}" unit="¥" bg="lavender"/>
      </view>
      <view class="ce-stats">
        <ll-stat-tile label="结算" value="{{totalPayout}}"   unit="¥" bg="mint"/>
        <ll-stat-tile label="退款" value="{{totalRefunded}}" unit="¥" bg="peach"/>
      </view>

      <!-- Ledger -->
      <view class="ll-section-title">最近活动</view>
      <view class="ce-section">
        <empty-state wx:if="{{rows.length === 0}}" icon="📒" title="暂无收益" subtitle="接受预约即可开始赚取收入"/>
        <view wx:for="{{rows}}" wx:key="_id" class="ce-row">
          <view class="ce-row-main">
            <text class="ce-row-kind">{{item.kindLabel}}</text>
            <text class="ce-row-date">{{item.dateLabel}}</text>
          </view>
          <text class="ce-row-amount ll-num {{item.amount >= 0 ? 'is-pos' : 'is-neg'}}">{{item.amountLabel}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
