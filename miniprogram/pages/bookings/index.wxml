<view class="ll-page brs-page">
  <mock-banner/>
  <offline-banner/>

  <!-- (a) Header + order-tab-bar -->
  <view class="brs-header">
    <view class="brs-header-row">
      <text class="brs-title">订单</text>
    </view>
    <ll-order-tab-bar active="{{activeTab}}" bind:change="onPickTab"/>
  </view>

  <!-- (b) Draft section — only on 全部 tab, only when basket has guardians -->
  <view wx:if="{{hasDraft && activeTab === '全部'}}" class="brs-draft">
    <ll-config-section config="{{config}}" bind:change="onConfigChange"/>

    <view class="brs-basket">
      <view class="brs-basket-head">
        <text class="brs-basket-head-label">已选守护者 <text class="brs-basket-head-count">({{draftRows.length}} 位)</text></text>
      </view>
      <block wx:for="{{draftRows}}" wx:for-item="row" wx:key="guardian.id">
        <view class="brs-basket-row {{index === draftRows.length - 1 ? 'is-last' : ''}}">
          <ll-guardian-draft-row
            guardian="{{row.guardian}}"
            checked="{{row.checked}}"
            service="{{config.service}}"
            price="{{row.price}}"
            unit="{{row.unit}}"
            data-id="{{row.guardian.id}}"
            bind:toggle="onToggleDraft"
            bind:remove="onRemoveDraft"
          />
        </view>
      </block>
      <view class="brs-basket-more" bindtap="onBrowseMore">
        <view class="brs-basket-more-ico">
          <ll-icon name="plus" size="36" color="#A0A0B0"/>
        </view>
        <text>继续添加守护者</text>
      </view>
    </view>

    <view class="brs-submit {{checkedCount > 0 ? 'is-on' : 'is-off'}}" bindtap="onSubmit">
      发送申请单<block wx:if="{{checkedCount > 0}}">  给 {{checkedCount}} 位守护者</block>
    </view>
  </view>

  <!-- (c) Apps list — batch-grouped active + historical -->
  <view class="brs-list">
    <block wx:if="{{!hasAny && pageStatus === 'empty'}}">
      <view class="brs-empty">暂无{{activeTab === '全部' ? '' : activeTab}}订单</view>
    </block>

    <view wx:for="{{batches}}" wx:for-item="batch" wx:key="key" class="brs-batch">
      <view class="brs-batch-sep">
        <view class="brs-batch-line"></view>
        <text class="brs-batch-time">{{batch.timeLabel}}</text>
        <view class="brs-batch-line"></view>
      </view>
      <view class="brs-batch-cards">
        <ll-sent-app-card
          wx:for="{{batch.apps}}"
          wx:for-item="app"
          wx:key="id"
          app="{{app}}"
          bind:opensummary="onOpenSummary"
          bind:openchat="onOpenChat"
          bind:rebook="onRebook"
          bind:writereview="onWriteReview"
        />
      </view>
    </view>

    <view wx:if="{{historical.length}}" class="brs-batch">
      <view class="brs-batch-sep">
        <view class="brs-batch-line"></view>
        <text class="brs-batch-time">历史订单</text>
        <view class="brs-batch-line"></view>
      </view>
      <view class="brs-batch-cards">
        <ll-sent-app-card
          wx:for="{{historical}}"
          wx:for-item="app"
          wx:key="id"
          app="{{app}}"
          bind:opensummary="onOpenSummary"
          bind:openchat="onOpenChat"
          bind:rebook="onRebook"
          bind:writereview="onWriteReview"
        />
      </view>
    </view>
  </view>
</view>
