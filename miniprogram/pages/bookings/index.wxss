.or-page { padding: 0 0 192rpx; }

.or-hdr { background: var(--ll-surface); box-shadow: 0 1px 0 rgba(0,0,0,0.06); }
.or-title {
  font-size: 44rpx; font-weight: 800; color: var(--ll-text);
  letter-spacing: -0.01em;
  padding: 32rpx 32rpx 20rpx;
}

.or-tabs-scroll { width: 100%; border-bottom: 1px solid var(--ll-border); }
.or-tabs { display: inline-flex; padding: 0 16rpx; }
.or-tab {
  flex: 0 0 auto;
  padding: 20rpx 28rpx;
  font-size: 26rpx; font-weight: 500; color: var(--ll-text-3);
  border-bottom: 5rpx solid transparent;
  margin-bottom: -1px;
  white-space: nowrap;
}
.or-tab.is-on { color: #D97757; font-weight: 700; border-bottom-color: #D97757; }

.or-list { padding: 24rpx 32rpx 0; display: flex; flex-direction: column; gap: 20rpx; }
.or-card {
  background: var(--ll-surface);
  border-radius: 32rpx;
  box-shadow: var(--ll-shadow-card);
  padding: 0 0 8rpx;
  display: flex; flex-direction: column;
}
.or-card-hover { background: var(--ll-surface-2); }

.or-row1 {
  display: flex; align-items: center; gap: 24rpx;
  padding: 28rpx;
}
.or-avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.or-avatar--butter   { background: var(--ll-butter); }
.or-avatar--lavender { background: var(--ll-lavender); }
.or-avatar--mint     { background: var(--ll-mint); }
.or-avatar--peach    { background: var(--ll-peach); }
.or-avatar-img       { width: 100%; height: 100%; }
.or-avatar-init      { font-size: 40rpx; font-weight: 700; color: var(--ll-text); }

.or-meta { flex: 1; min-width: 0; }
.or-meta-name-row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.or-meta-name     { font-size: 30rpx; font-weight: 700; color: var(--ll-text); }
.or-badge {
  font-size: 21rpx; font-weight: 700;
  padding: 4rpx 16rpx; border-radius: var(--ll-radius-pill);
  white-space: nowrap;
}
.or-meta-svc { font-size: 25rpx; color: var(--ll-text-3); display: block; }
.or-meta-pet { font-size: 24rpx; color: var(--ll-text-3); display: block; margin-top: 2rpx; }

.or-desc {
  padding: 0 28rpx 20rpx;
  display: flex; align-items: center; gap: 12rpx;
  font-size: 24rpx;
}
.or-pulse {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #F0B100;
  animation: orPulse 1.2s ease infinite;
}
@keyframes orPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.or-actions {
  display: flex; gap: 16rpx;
  padding: 0 28rpx 28rpx;
}
.or-btn {
  flex: 1; height: 76rpx;
  border-radius: var(--ll-radius-pill);
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 26rpx; font-weight: 600;
}
.or-btn--ghost  {
  background: transparent;
  color: var(--ll-text-2);
  box-shadow: inset 0 0 0 2rpx var(--ll-border);
}
.or-btn--accept { background: #2C7A4B; color: #fff; font-weight: 700; }
.or-btn--review { background: var(--ll-ink); color: #fff; font-weight: 700; }
