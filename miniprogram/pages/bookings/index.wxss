.brs-page {
  padding: 0 0 192rpx;
  min-height: 100vh;
  background: var(--ll-bg);
}

/* (a) Header */
.brs-header {
  background: var(--ll-surface);
  box-shadow: 0 1px 0 rgba(0,0,0,0.06);
}
.brs-header-row {
  padding: 32rpx 32rpx 20rpx;
  display: flex; align-items: center;
}
.brs-title {
  font-size: 44rpx; font-weight: 800; color: var(--ll-text);
  letter-spacing: -0.01em;
  flex: 1;
}

/* (b) Draft section */
.brs-draft {
  padding: 24rpx 32rpx 0;
  display: flex; flex-direction: column; gap: 24rpx;
}
.brs-basket {
  background: var(--ll-surface);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.brs-basket-head {
  padding: 24rpx 28rpx 20rpx;
  border-bottom: 1px solid var(--ll-border);
}
.brs-basket-head-label {
  font-size: 28rpx; font-weight: 700; color: var(--ll-text);
}
.brs-basket-head-count {
  font-size: 26rpx; font-weight: 500; color: var(--ll-text-3);
  margin-left: 8rpx;
}
.brs-basket-row { border-bottom: 1px solid var(--ll-border); }
.brs-basket-row.is-last { border-bottom: 0; }
.brs-basket-more {
  padding: 24rpx 28rpx;
  border-top: 1px dashed var(--ll-border);
  display: flex; align-items: center; gap: 24rpx;
  background: transparent;
}
.brs-basket-more-ico {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #F5F5FA;
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}
.brs-basket-more text {
  font-size: 27rpx; color: var(--ll-text-2);
}
.brs-submit {
  height: 100rpx;
  border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--ll-text-on-ink);
  font-size: 30rpx; font-weight: 700;
}
.brs-submit.is-on  { background: var(--ll-ink); }
.brs-submit.is-off { background: rgba(34,40,44,0.25); }

/* (c) List */
.brs-list { padding: 24rpx 32rpx 0; }
.brs-batch { margin-bottom: 40rpx; }
.brs-batch-sep {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 20rpx;
}
.brs-batch-line { flex: 1; height: 1px; background: var(--ll-border); }
.brs-batch-time {
  font-size: 23rpx; color: var(--ll-text-3); font-weight: 500;
}
.brs-batch-cards { display: flex; flex-direction: column; gap: 20rpx; }
.brs-empty {
  text-align: center;
  padding: 96rpx 48rpx;
  color: var(--ll-text-3);
  font-size: 28rpx;
}
