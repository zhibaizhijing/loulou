.rv-page {
  padding: 0 0 220rpx;
  min-height: 100vh;
  background: var(--ll-bg);
}

/* Guardian card */
.rv-guardian {
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  background: var(--ll-surface);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  display: flex; align-items: center; gap: 24rpx;
}
.rv-guardian-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: var(--ll-lavender);
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.rv-guardian-img { width: 100%; height: 100%; }
.rv-guardian-char { font-size: 36rpx; font-weight: 700; color: var(--ll-text); }
.rv-guardian-info { display: flex; flex-direction: column; gap: 4rpx; }
.rv-guardian-name { font-size: 32rpx; font-weight: 700; color: var(--ll-text); }
.rv-guardian-line { font-size: 25rpx; color: var(--ll-text-3); }

/* Stars */
.rv-stars-card {
  margin: 24rpx 32rpx 0;
  padding: 40rpx 28rpx 32rpx;
  background: var(--ll-surface);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  text-align: center;
}
.rv-stars-title {
  display: block;
  font-size: 28rpx; font-weight: 700; color: var(--ll-text);
  margin-bottom: 32rpx;
}
.rv-stars-row {
  display: flex; justify-content: center; gap: 20rpx;
  margin-bottom: 20rpx;
}
.rv-star { padding: 6rpx; }
.rv-star-label {
  font-size: 27rpx; font-weight: 600;
  color: #F5B301;
}

/* Tags */
.rv-tags-card {
  margin: 24rpx 32rpx 0;
  padding: 32rpx 28rpx;
  background: var(--ll-surface);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.rv-tags-title {
  display: block;
  font-size: 28rpx; font-weight: 700; color: var(--ll-text);
  margin-bottom: 24rpx;
}
.rv-tags-row {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.rv-tag {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: var(--ll-bg);
  color: var(--ll-text-2);
  font-size: 25rpx; font-weight: 500;
}
.rv-tag.is-on {
  background: var(--ll-ink);
  color: var(--ll-text-on-ink);
  font-weight: 700;
}

/* Comment */
.rv-comment-card {
  margin: 24rpx 32rpx 0;
  padding: 32rpx 28rpx;
  background: var(--ll-surface);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.rv-comment-title {
  display: block;
  font-size: 28rpx; font-weight: 700; color: var(--ll-text);
  margin-bottom: 20rpx;
}
.rv-textarea {
  width: 100%;
  min-height: 240rpx;
  background: var(--ll-bg);
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 27rpx;
  color: var(--ll-text);
  box-sizing: border-box;
}
.rv-textarea-hint { color: var(--ll-text-3); }
.rv-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--ll-text-3);
  margin-top: 12rpx;
}
.rv-photos {
  display: flex; gap: 20rpx;
  margin-top: 24rpx;
}
.rv-photo-tile {
  width: 152rpx; height: 152rpx;
  border-radius: 20rpx;
  background: var(--ll-bg);
  border: 3rpx dashed var(--ll-border);
  display: flex; align-items: center; justify-content: center;
}

/* Anonymous toggle */
.rv-anon-row {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: var(--ll-surface);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  display: flex; align-items: center; gap: 24rpx;
}
.rv-anon-text { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.rv-anon-title { font-size: 28rpx; font-weight: 700; color: var(--ll-text); }
.rv-anon-sub { font-size: 22rpx; color: var(--ll-text-3); }
.rv-toggle {
  width: 92rpx; height: 52rpx; border-radius: 999rpx;
  background: var(--ll-border);
  position: relative;
  transition: background var(--ll-dur-fast) var(--ll-ease);
}
.rv-toggle.is-on { background: #2C7A4B; }
.rv-toggle-knob {
  position: absolute;
  top: 6rpx; left: 6rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
  transition: left var(--ll-dur-fast) var(--ll-ease);
}
.rv-toggle.is-on .rv-toggle-knob { left: 46rpx; }

/* Submit */
.rv-foot {
  position: fixed; left: 0; right: 0;
  bottom: env(safe-area-inset-bottom);
  padding: 24rpx 32rpx 36rpx;
  background: var(--ll-bg);
}
