<view class="ll-page hm-page">
  <mock-banner />
  <offline-banner />

  <!-- ① BrandHeader: city · logo+slogan · spacer -->
  <view class="hm-brandhdr">
    <view class="hm-city">
      <ll-icon name="map-pin" size="26" color="#6B6B7A"/>
      <text>{{city}}</text>
      <ll-icon name="caret-down" size="22" color="#A0A0B0"/>
    </view>
    <view class="hm-brand">
      <view class="hm-brand-mark">Loulou 噜噜</view>
      <view class="hm-brand-slogan">让每一次分离都安心</view>
    </view>
    <view class="hm-brand-spacer"></view>
  </view>

  <!-- ② Combined search card -->
  <view class="hm-card">
    <view class="hm-card-head">选择服务</view>

    <view class="hm-svc-grid">
      <view
        wx:for="{{services}}"
        wx:key="id"
        class="hm-svc {{svcType === item.id ? 'is-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickSvc"
      >
        <view class="hm-svc-tile hm-svc-tile--{{item.bg}}">
          <ll-icon name="{{item.icon}}" size="44" color="#1E1E24"/>
        </view>
        <view class="hm-svc-label">{{item.id}}</view>
      </view>
    </view>

    <view class="hm-svc-hint">
      <text class="hm-svc-hint-id">{{selectedSvc.id}}</text>
      <text class="hm-svc-hint-sep">·</text>
      <text>{{selectedSvc.hint}}</text>
    </view>

    <view class="hm-card-divider"></view>

    <view class="hm-row" bindtap="onPickPetType">
      <view class="hm-row-icon"><ll-icon name="paw-print" size="30" color="#1E1E24"/></view>
      <text class="hm-row-label">宠物类型</text>
      <text class="hm-row-value">{{petType}}</text>
      <ll-icon name="caret-right" size="26" color="#A0A0B0"/>
    </view>

    <view class="hm-row" bindtap="onPickAddress">
      <view class="hm-row-icon"><ll-icon name="map-pin" size="30" color="#1E1E24"/></view>
      <text class="hm-row-label">地址</text>
      <text class="hm-row-value">{{address}}</text>
      <ll-icon name="caret-right" size="26" color="#A0A0B0"/>
    </view>

    <picker mode="date" start="{{minStart}}" value="{{startDate}}" bindchange="onStartDate">
      <view class="hm-row">
        <view class="hm-row-icon"><ll-icon name="calendar-blank" size="30" color="#1E1E24"/></view>
        <text class="hm-row-label">{{dateLabel}}</text>
        <text class="hm-row-value {{!dateSummary ? 'is-hint' : ''}}">{{dateSummary || '选择日期'}}</text>
        <ll-icon name="caret-right" size="26" color="#A0A0B0"/>
      </view>
    </picker>
    <picker wx:if="{{startDate && (svcType === '寄养' || svcType === '日托' || svcType === '伴宠留宿')}}" mode="date" start="{{minEnd}}" value="{{endDate}}" bindchange="onEndDate">
      <view class="hm-row">
        <view class="hm-row-icon"><ll-icon name="calendar-blank" size="30" color="#1E1E24"/></view>
        <text class="hm-row-label">退房日期</text>
        <text class="hm-row-value {{!endDate ? 'is-hint' : ''}}">{{endDate || '选择日期'}}</text>
        <ll-icon name="caret-right" size="26" color="#A0A0B0"/>
      </view>
    </picker>

    <view class="hm-search">
      <button class="hm-search-btn" bindtap="onSearch">
        <ll-icon name="magnifying-glass" size="36" color="#FFFFFF"/>
        <text class="hm-search-btn-text">搜索守护者</text>
      </button>
    </view>
  </view>

  <!-- ③ 收藏的守护者 -->
  <view class="hm-recents">
    <view class="hm-recents-head">
      <text class="hm-recents-title">收藏的守护者</text>
      <text class="hm-recents-sub">随时再次预约</text>
      <view class="hm-recents-all">
        <text>全部</text>
        <ll-icon name="caret-right" size="20" color="#6B6B7A"/>
      </view>
    </view>
    <scroll-view scroll-x="true" enhanced show-scrollbar="{{false}}" class="hm-recents-scroll">
      <view class="hm-recents-row">
        <view
          wx:for="{{recents}}"
          wx:key="id"
          class="hm-recent"
          data-id="{{item.id}}"
          bindtap="onPickRecent"
        >
          <view class="hm-recent-avatar">
            <image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill" class="hm-recent-img"/>
            <text wx:else class="hm-recent-init">{{item.initial}}</text>
          </view>
          <text class="hm-recent-name">{{item.name}}</text>
          <text wx:if="{{item.served}}" class="hm-recent-served">服务过</text>
          <view wx:else class="hm-recent-served-spacer"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ④ Banner carousel -->
  <view class="hm-banner-wrap">
    <view class="hm-banner hm-banner--{{currentBanner.bg}}" bindtap="onBanner">
      <view class="hm-banner-tag">{{currentBanner.tag}}</view>
      <view class="hm-banner-body">
        <view class="hm-banner-title">{{currentBanner.title}}</view>
        <view class="hm-banner-sub">{{currentBanner.sub}}</view>
      </view>
      <view wx:if="{{currentBanner.action === 'guide'}}" class="hm-banner-cta" catchtap="onOpenGuide">
        <text>查看指引</text>
        <ll-icon name="caret-right" size="22" color="#FFFFFF"/>
      </view>
      <view class="hm-banner-emoji">{{currentBanner.emoji}}</view>
      <view class="hm-banner-dots">
        <view
          wx:for="{{banners}}"
          wx:key="tag"
          class="hm-banner-dot {{bannerIdx === index ? 'is-on' : ''}}"
          data-i="{{index}}"
          catchtap="onBannerDot"
        ></view>
      </view>
    </view>
  </view>

  <!-- Pet type picker sheet -->
  <view wx:if="{{petPickerOpen}}" class="hm-mask" bindtap="onClosePetPicker"></view>
  <view wx:if="{{petPickerOpen}}" class="hm-sheet">
    <view class="hm-sheet-grab"></view>
    <view class="hm-sheet-head">
      <text class="hm-sheet-title">选择宠物类型</text>
      <view class="hm-sheet-close" bindtap="onClosePetPicker">
        <ll-icon name="x" size="26" color="#1E1E24"/>
      </view>
    </view>
    <view
      wx:for="{{petOptions}}"
      wx:key="*this"
      class="hm-sheet-row {{petType === item ? 'is-on' : ''}}"
      data-value="{{item}}"
      bindtap="onSelectPet"
    >
      <text>{{item}}</text>
      <ll-icon wx:if="{{petType === item}}" name="check-circle" weight="fill" size="32" color="#22282C"/>
    </view>
  </view>

  <!-- Address picker sheet -->
  <view wx:if="{{addressPickerOpen}}" class="hm-mask" bindtap="onCloseAddressPicker"></view>
  <view wx:if="{{addressPickerOpen}}" class="hm-sheet">
    <view class="hm-sheet-grab"></view>
    <view class="hm-sheet-head">
      <text class="hm-sheet-title">选择地址</text>
      <view class="hm-sheet-close" bindtap="onCloseAddressPicker">
        <ll-icon name="x" size="26" color="#1E1E24"/>
      </view>
    </view>
    <view
      wx:for="{{addressOptions}}"
      wx:key="*this"
      class="hm-sheet-row {{address === item ? 'is-on' : ''}}"
      data-value="{{item}}"
      bindtap="onSelectAddress"
    >
      <text>{{item}}</text>
      <ll-icon wx:if="{{address === item}}" name="check-circle" weight="fill" size="32" color="#22282C"/>
    </view>
  </view>
</view>
