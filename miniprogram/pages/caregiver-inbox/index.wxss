.page { padding:16rpx; }
.card { background:#fff; padding:24rpx; border-radius:12rpx; margin-bottom:12rpx; display:flex; flex-direction:column; gap:12rpx; }
.row { display:flex; justify-content:space-between; align-items:center; }
.title { font-size:28rpx; font-weight:500; }
.muted { font-size:24rpx; color:#666; }
.amount { font-size:28rpx; color:#16a34a; }
.notes { font-size:24rpx; color:#555; font-style:italic; padding:8rpx 12rpx; background:#f5f5f5; border-radius:8rpx; }
.actions { display:flex; gap:8rpx; }
