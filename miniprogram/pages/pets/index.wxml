<view class="ll-page pt-page">
  <ll-topnav title="我的宠物"/>

  <view class="pt-head">
    <view class="pt-head-title">我的宠物 ({{pets.length}})</view>
    <view class="pt-head-desc">帮助守护者了解您的宠物，接受您的申请，提供安全、贴心的照料。</view>
  </view>

  <view wx:if="{{pets.length === 0}}" class="pt-empty">
    <ll-icon name="paw-print" size="80" color="#A0A0B0"/>
    <text>尚未添加宠物</text>
  </view>

  <view class="pt-list">
    <view wx:for="{{pets}}" wx:key="id" class="pt-card" data-id="{{item.id}}" bindtap="onPickPet">
      <view class="pt-avatar pt-avatar--{{index % 4 === 0 ? 'butter' : index % 4 === 1 ? 'lavender' : index % 4 === 2 ? 'mint' : 'peach'}}">
        <ll-icon name="paw-print" weight="fill" size="56" color="#22282C"/>
      </view>
      <view class="pt-body">
        <view class="pt-name">{{item.name}}</view>
        <view class="pt-breed">{{item.breed || '混血'}}</view>
        <view class="pt-detail" wx:if="{{item.detail}}">{{item.detail}}</view>
      </view>
      <ll-icon name="caret-right" size="26" color="#A0A0B0"/>
    </view>
  </view>

  <view class="pt-add" bindtap="onToggleAdd">
    <ll-icon name="plus" size="28" color="#1E1E24"/>
    <text>添加宠物</text>
  </view>

  <dog-form wx:if="{{addingDog}}" bind:save="onSaveDog"/>
</view>
