.page { padding:24rpx; background:#fff; min-height:100vh; }
.header { display:flex; justify-content:space-between; align-items:center; margin-bottom:24rpx; }
.month-label { font-size:32rpx; font-weight:600; }
.weekdays { display:grid; grid-template-columns:repeat(7,1fr); margin-bottom:8rpx; }
.weekday { text-align:center; font-size:22rpx; color:#888; padding:8rpx 0; }
.grid { display:grid; grid-template-columns:repeat(7,1fr); gap:8rpx; }
.cell { aspect-ratio:1; display:flex; align-items:center; justify-content:center; border-radius:8rpx; font-size:24rpx; }
.cell.empty { background:transparent; }
.cell.available { background:#dcfce7; color:#166534; }
.cell.blocked { background:#fee2e2; color:#991b1b; }
.cell.past { background:#f5f5f5; color:#bbb; }
.day-num { font-size:24rpx; }
.legend { display:flex; gap:24rpx; margin-top:32rpx; font-size:22rpx; color:#555; }
.legend-item { display:flex; align-items:center; gap:8rpx; }
.swatch { width:24rpx; height:24rpx; border-radius:4rpx; }
.swatch.available { background:#dcfce7; }
.swatch.blocked { background:#fee2e2; }
.swatch.past { background:#f5f5f5; }
